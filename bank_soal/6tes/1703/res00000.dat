	<QUESTION_MULTIPLEANSWER id='q12'>
		<BODY>
			<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Perhatikan tabel berikut!<br><br>No&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Besaran&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Satuan dalam SI<br>1&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Jumlah zat&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Mole<br>2&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Suhu&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Celcius<br>3&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Waktu&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Sekon<br>4&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Panjang&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Kilometer<br>5&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Massa&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Gram<br>Pasangan yang benar adalah ....(Jawaban lebih dari satu)<br></span></span>]]></TEXT>
			<FLAGS>
				<ISHTML value='true'/>
				<ISNEWLINELITERAL value='false'/>
			</FLAGS>
		</BODY>
		<ANSWER id='q12_a1' position='1'>
