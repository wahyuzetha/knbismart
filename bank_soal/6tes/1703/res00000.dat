		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">0,5 m/s2</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q4_a2' position='2'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">1,0 m/s2</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q4_a3' position='3'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">1,5 m/s2</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q4_a4' position='4'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">2,0 m/s2</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q4_a5' position='5'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">2,5 m/s2</span></span>]]></TEXT>
