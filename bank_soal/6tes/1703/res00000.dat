	<QUESTION_MULTIPLECHOICE id='q1'>
		<BODY>
			<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Besaran di bawah ini yang semuanya merupakan besaran pokok adalah ...</span></span>]]></TEXT>
			<FLAGS>
				<ISHTML value='true'/>
				<ISNEWLINELITERAL value='false'/>
			</FLAGS>
		</BODY>
		<ANSWER id='q1_a1' position='1'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Percepatan, kecepatan, dan massa jenis</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q1_a2' position='2'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Massa jenis , jarak, dan perpindahan</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q1_a3' position='3'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Waktu, massa , dan kecepatan</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q1_a4' position='4'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Massa, intensitas cahaya, dan suhu</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q1_a5' position='5'>
		<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Perpindahan, kecepatan, dan kuat arus</span></span>]]></TEXT>
		</ANSWER>
		<GRADABLE>
			<CORRECTANSWER answer_id='q1_a4'/>
		</GRADABLE>
	</QUESTION_MULTIPLECHOICE>
	<QUESTION_MULTIPLECHOICE id='q2'>
		<BODY>
			<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Diantara kelompok besaran dibawah ini yang merupakan besaran pokok adalah &#8230;.</span></span>]]></TEXT>
			<FLAGS>
				<ISHTML value='true'/>
				<ISNEWLINELITERAL value='false'/>
			</FLAGS>
		</BODY>
		<ANSWER id='q2_a1' position='1'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Kuat arus, massa, panjang</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q2_a2' position='2'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Suhu, massa, volume</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q2_a3' position='3'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Waktu, momentum, percepatan</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q2_a4' position='4'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Usaha, Momentum, percepatan</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q2_a5' position='5'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Kecepatan, Suhu, Jumlah zat</span></span>]]></TEXT>
		</ANSWER>
		<GRADABLE>
			<CORRECTANSWER answer_id='q2_a1'/>
		</GRADABLE>
	</QUESTION_MULTIPLECHOICE>
	<QUESTION_MULTIPLECHOICE id='q3'>
		<BODY>
			<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Diantara kelompok besaran di bawah ini yang merupakan besaran turunan adalah &#8230;.</span></span>]]></TEXT>
			<FLAGS>
				<ISHTML value='true'/>
				<ISNEWLINELITERAL value='false'/>
			</FLAGS>
		</BODY>
		<ANSWER id='q3_a1' position='1'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Massa, panjang, waktu</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q3_a2' position='2'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Percepatan, kecepatan, massa jenis</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q3_a3' position='3'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Massa jenis, kuat arus, intensitas cahaya</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q3_a4' position='4'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Intensitas cahaya, jumlah zat, massa</span></span>]]></TEXT>
		</ANSWER>
		<ANSWER id='q3_a5' position='5'>
		<TEXT><![CDATA[<span style="font-family:'Arial Narrow'"><span style="font-size:10pt">Jumlah zat, massa, kuat arus</span></span>]]></TEXT>
		</ANSWER>
		<GRADABLE>
			<CORRECTANSWER answer_id='q3_a2'/>
		</GRADABLE>
	</QUESTION_MULTIPLECHOICE>
	<QUESTION_MULTIPLECHOICE id='q4'>
		<BODY>
			<TEXT><![CDATA[<span style="font-family:'Calibri'"><span style="font-size:10pt">Seorang anak berlari dengan kecepatan awal 10 m/s dan setelah 10 detik kecepatannya berubah menjadi 20 m/s.&nbsp; Percepatan anak tersebut adalah ...</span></span>]]></TEXT>
